# ---- WhatsApp Cloud API (Meta) ----
# Token del System User con permiso whatsapp_business_messaging.
WHATSAPP_TOKEN=
# ID del número emisor (Meta Business > WhatsApp > API Setup). NO es el número.
WHATSAPP_PHONE_NUMBER_ID=
# Cadena que tú inventas y capturas en Meta al registrar el webhook.
WHATSAPP_VERIFY_TOKEN=un-secreto-que-tu-elijas
# App Secret de la app de Meta. Se usa para validar la firma de cada webhook.
WHATSAPP_APP_SECRET=
WHATSAPP_GRAPH_VERSION=v21.0

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low mantiene la latencia baja en chat. Sube a medium si necesitas más criterio.
ANTHROPIC_EFFORT=low

# ---- CRM (Supabase teravino-crm) ----
# Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=https://tbpstqkorhkdfedqiblr.supabase.co
# service_role key: da acceso total saltándose RLS. NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Estatus con el que entran los pedidos del bot, para que el vendedor los revise.
ORDER_STATUS=borrador
ORDER_PREFIX=COT
# Almacén y nivel de precio para cuentas sin región o números no identificados.
DEFAULT_WAREHOUSE=Los Cabos
DEFAULT_PRICE_TIER=+10

# ---- Negocio ----
BUSINESS_NAME=Teravino Wine & Spirits
BUSINESS_HOURS=Lunes a viernes de 9:00 a 18:00 (hora de Los Cabos)
# Opcional: a quién derivar cuando el agente no puede resolver.
HANDOFF_CONTACT=

# ---- Servidor ----
PORT=3000
HISTORY_TURNS=20
# SQLite guarda sólo la transcripción del chat; el negocio vive en el CRM.
DATABASE_PATH=./data/agent.db
