# ---- Telegram ----
# Token que te da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=

# 'polling' no necesita dominio público ni HTTPS: ideal para desarrollo.
# 'webhook' es lo recomendable en producción.
TELEGRAM_MODE=polling
TELEGRAM_POLL_TIMEOUT=30

# Sólo en modo webhook:
TELEGRAM_WEBHOOK_URL=
# Cadena que tú inventas. Telegram la reenvía y así verificamos el origen.
TELEGRAM_WEBHOOK_SECRET=

# ---- Claude ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
# low mantiene la latencia baja en chat. Sube a medium si necesitas más criterio.
ANTHROPIC_EFFORT=low

# ---- CRM (Supabase teravino-crm) ----
# Project Settings > API en el dashboard de Supabase.
SUPABASE_URL=https://tbpstqkorhkdfedqiblr.supabase.co
# service_role key: da acceso total saltándose RLS. NUNCA la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Estatus con el que entran los pedidos del bot, para que el vendedor los revise.
ORDER_STATUS=borrador
ORDER_PREFIX=COT
# Almacén y nivel de precio para cuentas sin región o clientes no identificados.
DEFAULT_WAREHOUSE=Los Cabos
DEFAULT_PRICE_TIER=+10

# ---- Negocio ----
BUSINESS_NAME=Teravino Wine & Spirits
BUSINESS_HOURS=Lunes a viernes de 9:00 a 18:00 (hora de Los Cabos)
# Opcional: a quién derivar cuando el agente no puede resolver.
HANDOFF_CONTACT=

# ---- Servidor ----
PORT=3000
HISTORY_TURNS=20
# SQLite guarda la transcripción, las identidades y la deduplicación.
# El negocio vive en el CRM.
DATABASE_PATH=./data/agent.db
